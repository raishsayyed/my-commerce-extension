{
  "openapi": "3.0.0",
  "info": {
    "title": "Product Enrichment API",
    "version": "1.0.0",
    "description": "Product data, including the current saved Commerce price, for EDS storefronts via I/O Runtime."
  },
  "servers": [
    {
      "url": "https://3967933-888beigetuna-stage.adobeioruntime.net/api/v1/web/course-labs"
    }
  ],
  "paths": {
    "/product-enrichment": {
      "get": {
        "operationId": "getProductEnrichment",
        "summary": "Get product data and current price",
        "description": "Fetches the product by SKU from Adobe Commerce when called. Use this from the EDS storefront to display the latest saved price.",
        "parameters": [
          {
            "name": "sku",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The product SKU to enrich"
          }
        ],
        "responses": {
          "200": {
            "description": "Enriched product data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sku": { "type": "string" },
                    "name": { "type": "string" },
                    "price": { "type": "number" },
                    "sustainabilityScore": { "type": "integer" },
                    "estimatedDelivery": { "type": "string" },
                    "enrichedAt": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "204": {
            "description": "CORS preflight accepted"
          }
        }
      }
    }
  }
}
